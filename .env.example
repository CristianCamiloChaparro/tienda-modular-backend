# Copie este archivo como .env (junto al pom.xml) y ponga valores reales.
# .env esta en .gitignore: los secretos nunca se suben al repositorio.
# Spring Boot lo lee con spring.config.import y Docker Compose lo lee automaticamente.
# Para generar claves largas y aleatorias: openssl rand -hex 32

# ---------- Base de datos (obligatoria) ----------
DB_USER=tienda
DB_PASSWORD=
# Opcionales: DB_URL completa, o DB_HOST / DB_PORT / DB_NAME (por defecto localhost:5432/tienda_modular)

# ---------- Administrador inicial (se crea solo si no existe ningun ADMIN) ----------
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=

# ---------- HTTPS local (perfil "https"). Con mkcert siempre es "changeit" ----------
SSL_PASSWORD=changeit

# ---------- Opcionales ----------
# COOKIE_SECURE=true            # en produccion (Render) las cookies solo viajan por HTTPS
# CORS_ORIGINS=http://localhost:5173
